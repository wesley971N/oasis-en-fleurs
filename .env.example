# Copier ce fichier en .env pour le développement local (`netlify dev`).
# En production, ces variables se configurent dans Netlify : Site settings → Environment variables.
# Aucune valeur réelle ici — ce fichier ne doit JAMAIS contenir de vraie clé secrète.

# ── Stripe ───────────────────────────────────────────────────────────────────
# Clé secrète : Stripe Dashboard → Developers → API keys (commence par sk_test_ ou sk_live_)
STRIPE_SECRET_KEY=

# Secret de signature du webhook : créé après avoir configuré le endpoint webhook
# dans Stripe Dashboard → Developers → Webhooks → pointer vers
# https://<votre-site>.netlify.app/api/stripe-webhook, événement "checkout.session.completed"
STRIPE_WEBHOOK_SECRET=

# Optionnel : ID d'un Tax Rate créé dans Stripe Dashboard → Settings → Tax → Tax rates,
# pour appliquer la TVA d'Agnès sur chaque ligne de commande. Tant que cette variable
# n'est pas définie, les commandes partent SANS TVA appliquée — taux exact à confirmer
# avec Agnès avant la mise en prod (voir specs/projet.md).
STRIPE_TAX_RATE_ID=

# ── Frais de port (France uniquement — specs/projet.md) ─────────────────────
# Montant fixe en centimes (ex. 490 = 4,90€). Grille réelle à confirmer avec Agnès.
SHIPPING_FLAT_FEE_CENTS=

# Optionnel : seuil de livraison gratuite en centimes (ex. 6000 = 60€). Laisser vide
# si la livraison n'est jamais gratuite.
FREE_SHIPPING_THRESHOLD_CENTS=

# ── Google Sheets (gestion des stocks) ───────────────────────────────────────
# Le tableau doit contenir un onglet nommé exactement "Stock" avec 3 colonnes,
# en-têtes en première ligne : id | nom | stock
# (id = identifiant produit du site, voir src/data/products.ts)
#
# 1. Créer un compte de service sur https://console.cloud.google.com/
#    (APIs & Services → Credentials → Create service account)
# 2. Activer l'API Google Sheets pour ce projet GCP
# 3. Partager le Google Sheet avec l'email du compte de service (accès "Éditeur")
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ── Email de notification de commande (Resend) ───────────────────────────────
# Clé API : https://resend.com/api-keys
RESEND_API_KEY=

# Adresse d'envoi — doit appartenir à un domaine vérifié dans Resend
# (https://resend.com/domains), sinon utiliser le sandbox onboarding@resend.dev
# pour les tests uniquement.
RESEND_FROM_EMAIL=

# Optionnel : adresse qui reçoit la notification de commande.
# Par défaut : contact@loasisenfleurs.com (specs/projet.md)
NOTIFY_EMAIL=

# ── Site ──────────────────────────────────────────────────────────────────────
# Optionnel : uniquement nécessaire en dehors de Netlify (où URL est déjà fournie
# automatiquement). Utilisé pour les redirections après paiement Stripe.
SITE_URL=
